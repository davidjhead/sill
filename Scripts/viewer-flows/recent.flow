# All Apps' Recent: empty until something is opened from here, then the apps and the Desktop opened, the
# latest first; the favourites stay whatever the order (one added in A to Z, never opened).
wait apps 30
# A favourite in A to Z (Calculator: third row, first column, with this Mac's apps), never opened from here
rightclick 273 430
choose Add to Favourites
expect launcher.favourites contains Calculator
# The menu bar menu's Favourites lists it, and Recent says nothing is opened yet
expect menuFavourites.0 == Calculator
expect menuRecent.0 == Nothing opened from here yet
# Recent: empty, and the favourite still there (the shelf moved All Apps down: the switch is at 225)
click 867 225
expect launcher.appOrder == recent
expect launcher.recent == []
expect launcher.favourites contains Calculator
snap recent-empty.png
# An app opened from the search (the test host logs the launch and opens nothing)
click 760 34
type chess
key return
key esc
launcher show
expect launcher.recent contains Chess
expect launcher.recent !contains Calculator
# The Desktop opened from the sidebar comes first
click 75 242
wait stream 15
launcher show
expect launcher.recent.0 == Desktop
expect launcher.recent.1 == Chess
# The menu bar menu's Recent: the same, latest first, whichever order All Apps shows
expect menuRecent.0 == Desktop
expect menuRecent.1 == Chess
# Its Favourites opens the app (the test host logs the launch)
statusmenu favourites Calculator
expect launcher.recent.0 == Calculator
expect launcher.favourites contains Calculator
snap recent-filled.png
# Back to A to Z: every app, the favourite still there
click 813 225
expect launcher.appOrder == name
expect launcher.favourites contains Calculator
